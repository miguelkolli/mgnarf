  "project": {
    "id": "narf",
    "name": "NARF",
    "type": "guardrail"
  },
  "repository": {
    "id": "narf",
    "url": "https://github.com/miguelkolli/narf.git",
    "default_branch": "main"
  },
  "architecture": {
    "reference_runtime": {
      "enabled": true,
      "path": "src/narf",
      "runtime": "python"
    },
    "authenticated_receipts": {
      "enabled": true,
      "owner": "trusted-host",
      "authority": "acceptance-evidence"
    }
  },
  "verification": {
    "smoke": [
      {
        "name": "standalone-unit-suite",
        "type": "command",
        "command": "PYTHONPATH=src python3 -m unittest discover -s tests -v",
        "cwd": ".",
        "timeout_seconds": 120
      },
      {
        "name": "compile-check",
        "type": "command",
        "command": "python3 -m compileall -q src tests",
        "cwd": ".",
        "timeout_seconds": 120
      }
    ],
    "health": [],
    "domains": {
      "runtime": [
        {
          "name": "standalone-unit-suite",
          "type": "command",
          "command": "PYTHONPATH=src python3 -m unittest discover -s tests -v",
          "cwd": ".",
          "timeout_seconds": 120
        }
      ]
    }
  },
  "quality": {
    "source_roots": [
      "src"
    ],
    "test_roots": [
      "tests"
    ],
